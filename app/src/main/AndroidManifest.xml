<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <application
        android:name="com.syncodec.graphite.BaseApplication"
        android:allowBackup="false"
        android:appCategory="productivity"
        android:description="@string/app_description"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:resizeableActivity="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Graphite">

        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
        <meta-data
            android:name="CLIENT_KEY"
            android:value="${clientKey}" />
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />
        <meta-data
            android:name="TMDB_API_KEY"
            android:value="${tmdbApiKey}" />

        <meta-data
            android:name="REVENEUE_CAT_API_KEY"
            android:value="${revenueCatApiKey}" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${providerAuthorities}"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_path" />
        </provider>

        <activity
            android:name="com.syncodec.graphite.presentation.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Graphite.NoActionBar"
            android:usesCleartextTraffic="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--			<intent-filter>-->
            <!--				<action android:name="android.intent.action.SEND" />-->
            <!--				<category android:name="android.intent.category.DEFAULT" />-->
            <!--				<data android:mimeType="application/*" />-->
            <!--				<data android:mimeType="audio/*" />-->
            <!--				<data android:mimeType="image/*" />-->
            <!--				<data android:mimeType="message/*" />-->
            <!--				<data android:mimeType="multipart/*" />-->
            <!--				<data android:mimeType="text/*" />-->
            <!--				<data android:mimeType="video/*" />-->
            <!--			</intent-filter>-->
        </activity>

        <activity
            android:name=".presentation.note.NoteActivity"
            android:exported="false"
            android:parentActivityName=".presentation.main.MainActivity"
            android:theme="@style/Theme.Graphite.NoActionBar"
            android:windowSoftInputMode="adjustResize">
        </activity>

        <activity
            android:name=".presentation.tags.TagsActivity"
            android:exported="false"
            android:theme="@style/Theme.Graphite.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.attachment.AttachmentActivity"
            android:exported="false"
            android:theme="@style/Theme.Graphite.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.notebook.NotebookActivity"
            android:exported="false"
            android:theme="@style/Theme.Graphite.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.bucket.BucketActivity"
            android:exported="false"
            android:theme="@style/Theme.Graphite.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.bucketItem.activity.BookBucketItemActivity"
            android:exported="false"
            android:theme="@style/Theme.Graphite.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.bucketItem.activity.ShowBucketItemActivity"
            android:exported="false"
            android:theme="@style/Theme.Graphite.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.search.SearchActivity"
            android:exported="false"
            android:theme="@style/Theme.Graphite.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.explorer.atlas.AtlasActivity"
            android:exported="false"
            android:theme="@style/Theme.Graphite.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.explorer.calendar.CalendarActivity"
            android:exported="false"
            android:theme="@style/Theme.Graphite.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.pro.ProActivity"
            android:exported="false"
            android:theme="@style/Theme.Graphite.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Graphite.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.report.ReportActivity"
            android:exported="false"
            android:theme="@style/Theme.Graphite.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.sync.dropbox2.DropboxActivity"
            android:exported="true"
            android:theme="@style/Theme.Graphite.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="graphite.syncodec.com" />
                <data android:pathPrefix="/dropboxCallback" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.sync.googleDrive.GoogleDriveSyncActivity"
            android:exported="true"
            android:theme="@style/Theme.Graphite.NoActionBar"
            android:windowSoftInputMode="adjustResize" >
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="graphite.syncodec.com" />
                <data android:pathPrefix="/googleDriveCallback" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.sync.oneDrive.OneDriveSyncActivity"
            android:exported="false"
            android:theme="@style/Theme.Graphite.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <receiver android:name=".notification.WriteNoteBroadcastReceiver" />

        <receiver android:name=".notification.UnpinNotificationBroadcastReceiver" />

